{
  "name": "mobile-api-v2",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun drizzle-kit migrate  --config=drizzle.config.ts",
    "db:studio": "bun drizzle-kit studio   --config=drizzle.config.ts",
    "db2:generate": "bun drizzle-kit generate --config=drizzle.second.config.ts",
    "db2:migrate": "bun drizzle-kit migrate  --config=drizzle.second.config.ts",
    "db2:studio": "bun drizzle-kit studio   --config=drizzle.second.config.ts",
"supadb:generate": "bun drizzle-kit generate --config=drizzle.supabase.config.ts",
"supadb:migrate": "bun drizzle-kit migrate --config=drizzle.supabase.config.ts",
"supadb:studio": "bun drizzle-kit studio --config=drizzle.supabase.config.ts",
  "db:migrate:all": "bun run db:migrate && bun run db2:migrate && bun run supadb:migrate",
"db:generate:all": "bun run db:generate && bun run db2:generate && bun run supadb:generate"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@supabase/supabase-js": "^2.116.0",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.3",
    "postgres": "^3.4.9"
  }
}
