{
  "name": "bun-elysia-postgres",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun drizzle-kit migrate  --config=drizzle.config.ts",
    "db:studio": "bun drizzle-kit studio   --config=drizzle.config.ts",
    "db2:generate": "bun drizzle-kit generate --config=drizzle.second.config.ts",
    "db2:migrate": "bun drizzle-kit migrate  --config=drizzle.second.config.ts",
    "db2:studio": "bun drizzle-kit studio   --config=drizzle.second.config.ts",
    "supadb:generate": "bun drizzle-kit generate --config=drizzle.supabase.config.ts",
    "supadb:migrate": "bun drizzle-kit migrate --config=drizzle.supabase.config.ts",
    "supadb:studio": "bun drizzle-kit studio --config=drizzle.supabase.config.ts",
    "db:migrate:all": "bun run db:migrate && bun run db2:migrate && bun run supadb:migrate",
    "db:generate:all": "bun run db:generate && bun run db2:generate && bun run supadb:generate"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/hono": "^9.10.2",
    "@elastic/elasticsearch": "^9.5.1",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@google-cloud/vision": "^6.1.1",
    "@opensearch-project/opensearch": "^3.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/qstash": "^2.12.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.10",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "expo-server-sdk": "^7.2.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.13.12",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "openapi-types": "^12.1.3",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "resend": "^6.31.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {}
}