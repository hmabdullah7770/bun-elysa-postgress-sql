{
  "name": "mobile-api-v2",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate":  "bun drizzle-kit generate --config=drizzle.config.ts",
  "db:migrate":   "bun drizzle-kit migrate  --config=drizzle.config.ts",
  "db:studio":    "bun drizzle-kit studio   --config=drizzle.config.ts",

  "db2:generate": "bun drizzle-kit generate --config=drizzle.second.config.ts",
  "db2:migrate":  "bun drizzle-kit migrate  --config=drizzle.second.config.ts",
  "db2:studio":   "bun drizzle-kit studio   --config=drizzle.second.config.ts",

  "db:migrate:all":  "bun run db:migrate  && bun run db2:migrate",
  "db:generate:all": "bun run db:generate && bun run db2:generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "^1.3.1",
    "cloudinary": "^2.9.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "postgres": "^3.4.8"
  }
}
